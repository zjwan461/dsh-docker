# Build context for the admin image is admin/. Keep the image to the app itself:
# no tests, no local virtualenv, no operator-local config.

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_cache

# Tests and dev tooling are not part of the running service.
tests/
pytest.ini
requirements-dev.txt

# Host-run helpers and docs.
.env
.env.example
README.md
run.sh

Dockerfile
.dockerignore
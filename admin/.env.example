# Only needed when running the panel DIRECTLY on the host (./run.sh) for
# development. In Docker — the normal way — every one of these arrives as a real
# environment variable from compose.yaml's `admin` service, and this file is not
# read at all (it does not exist inside the image).
#
# Copy to admin/.env and adjust.

# ── where the panel listens ─────────────────────────────────────────────────
#
# 127.0.0.1 is the only value that is allowed to run without a password.
ADMIN_BIND_HOST=127.0.0.1
ADMIN_BIND_PORT=8642

# ── authentication ──────────────────────────────────────────────────────────
#
# MANDATORY unless ADMIN_BIND_HOST is 127.0.0.1/::1/localhost. The app refuses to
# start otherwise: it prints a live login token and (in Docker) holds the Docker
# socket.
ADMIN_PASSWORD=
ADMIN_USER=admin

# ── which container to read ─────────────────────────────────────────────────
#
# Leave ADMIN_CONTAINER empty to find the dsh container by compose labels, then
# by container name (dsh-dsh-1). Set it to a name or ID to skip discovery.
ADMIN_CONTAINER=
ADMIN_COMPOSE_PROJECT=dsh
ADMIN_COMPOSE_SERVICE=dsh
ADMIN_DOCKER_TIMEOUT=15

# ── log window ──────────────────────────────────────────────────────────────
#
# The panel asks the daemon for `since = <container start>`, so it only ever sees
# the CURRENT run. It starts with a small window (cheap) and widens it once when
# no token line is inside.
ADMIN_LOG_TAIL=200
ADMIN_LOG_TAIL_MAX=20000
ADMIN_STARTUP_LINES=40

# ── login link ──────────────────────────────────────────────────────────────
#
# Left empty => taken from ../.env (DSH_SITE_ADDRESS / DSH_PUBLIC_PORT).
# Authority only, no scheme — the panel adds https:// itself.
ADMIN_SITE_ADDRESS=
ADMIN_PUBLIC_PORT=

# Page auto-refresh interval, seconds.
ADMIN_REFRESH_SECONDS=5
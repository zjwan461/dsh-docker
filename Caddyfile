# Caddyfile — TLS terminator for the containerised DeepSeek Harness Web GUI.
#
# Deployment target: https://dsh.example.com
#
# The dsh service publishes no port at all; this is the single network entry
# point. DSH's server carries no TLS of its own and its browser session cookie
# is deliberately not marked `Secure` (it assumes loopback HTTP), so keep this
# the ONLY way in and never add a plain-HTTP listener for the same host name:
# an unencrypted request to the same authority would send that cookie.

{
	# The example domain is one you cannot obtain a public certificate for, and
	# a `.local` name (reserved by RFC 6762 for multicast DNS) never can be
	# either, so ACME is not attempted here at all: the internal issuer
	# selected below is the only certificate source.
	#
	# disable_redirects drops Caddy's :80 HTTP->HTTPS redirect listener. Port 80
	# is never published, and leaving that listener out removes any chance of a
	# later port mapping exposing the session cookie over plaintext.
	auto_https disable_redirects
}

https://{$DSH_SITE_ADDRESS} {
	# `dsh.example.com` is the GUI site — the only site this deployment
	# serves.

	# ---------------------------------------------------------------------
	# TLS — use exactly ONE of the two options
	# ---------------------------------------------------------------------

	# Option A (default, needs no certificate material): Caddy's built-in local
	# CA. The certificate is issued on the first request; clients show a warning
	# until they trust that CA. Export it with:
	#   docker compose exec caddy cat /data/caddy/pki/authorities/local/root.crt > caddy-root.crt
	# then import caddy-root.crt into the OS / browser trust store.
	tls internal

	# Option B (no browser warning): a certificate from your own internal CA.
	# Comment out `tls internal` above, uncomment the line below, and drop the
	# two files into ./certs (mounted read-only at /certs):
	# tls /certs/dsh.example.com.crt /certs/dsh.example.com.key
	# Option C — THE ONE FOR A PUBLIC ADDRESS: let Caddy obtain a certificate from
	# Let's Encrypt / ZeroSSL over ACME. Point DSH_SITE_ADDRESS at a real hostname
	# that resolves to this machine, comment out `tls internal` above, and either
	# remove this `tls` line or give it your contact address. Caddy validates via
	# TLS-ALPN-01 on :443, so :80 does not need to be published for it to work.
	# requirements: the name resolves publicly, and this host's :443 is reachable.
	# tls admin@example.com

	# ---------------------------------------------------------------------
	# Headers
	# ---------------------------------------------------------------------
	header {
		# Only meaningful once clients actually trust the certificate (Option A
		# after the CA import, or Option B). Browsers do NOT record HSTS from a
		# connection with a certificate error, so the "proceed anyway" click keeps
		# working with the untrusted internal CA — but once the CA HAS been trusted
		# and later breaks, HSTS removes that button. See the README troubleshooting
		# table for the escape hatch.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# ---------------------------------------------------------------------
	# Optional second factor in front of DSH's own launch-token login.
	# Generate the hash with:
	#   docker compose exec caddy caddy hash-password --plaintext 'your-password'
	# ---------------------------------------------------------------------
	# basic_auth {
	# 	you $2a$14$REPLACE_WITH_HASH
	# }

	# ---------------------------------------------------------------------
	# Upstream
	# ---------------------------------------------------------------------
	# The Host header MUST reach DSH unchanged: the /api browser-trust fence
	# compares it against DSH_TRUSTED_HOSTS, and the session cookie is bound to
	# the host name plus port. reverse_proxy preserves the incoming Host by
	# default — do not add a header_up Host override here.
	reverse_proxy {$DSH_UPSTREAM} {
		# Stream Server-Sent Events and WebSocket frames without buffering.
		# Without this the GUI connects but never finishes loading.
		flush_interval -1
	}
}

# ---------------------------------------------------------------------------
# OPTIONAL, and dangerous: a plaintext listener on :80.
#
# READ THE ADDRESS YOU ARE SERVING. An allowlist limits who may CONNECT; it does
# nothing about who can SNIFF. When DSH_SITE_ADDRESS is a public address — or any
# network you do not fully control — enabling this hands an agent that runs
# commands inside this container to whoever is on the path, because the session
# cookie is deliberately not marked Secure and therefore travels in the clear on
# every request. On a public address use Option C above (a real domain, so there
# is no warning and no cleartext) or an SSH tunnel to a loopback port (README
# 「出路 B」), where the cookie never leaves the client machine.
#
# If this really is a network you control: uncomment the site below, publish :80
# in compose.yaml, and set DSH_HTTP_ALLOWED_RANGES to the addresses that may use
# it (everything else gets 403). The address comes from the same variable as the
# site above, so nothing here is hardcoded.
#
# http://{$DSH_SITE_ADDRESS} {
# 	@allowed remote_ip {$DSH_HTTP_ALLOWED_RANGES:127.0.0.1/32 ::1/128}
# `thandle @allowed {
# 		reverse_proxy {$DSH_UPSTREAM} {
# `t`t`tflush_interval -1
# `t`t}
# `t}
# `trespond "plaintext listener: your address is not in DSH_HTTP_ALLOWED_RANGES. See compose.yaml." 403
# }

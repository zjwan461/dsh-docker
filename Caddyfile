# Caddyfile — TLS terminator for the containerised DeepSeek Harness Web GUI.
#
# Deployment target: https://dsh.example.com
#
# The dsh service publishes no port at all; this is the network entry point. DSH
# carries no TLS of its own and its session cookie is deliberately not marked
# `Secure` (it assumes loopback HTTP), so plaintext to the same authority sends it
# in the clear. The plaintext site at the end of this file is the single sanctioned
# exception, and it is off in practice: it answers nobody until :80 is published

{
	# The example domain is one you cannot obtain a public certificate for, and
	# a `.local` name (reserved by RFC 6762 for multicast DNS) never can be
	# either, so ACME is not attempted here at all: the internal issuer
	# selected below is the only certificate source.
	#
	# disable_redirects drops Caddy's :80 HTTP->HTTPS redirect listener, leaving :80 free
	# for the plaintext site at the end of this file. That site answers nobody until :80
	# is published AND its allowlist names your clients.
	auto_https disable_redirects
}

https://{$DSH_SITE_ADDRESS} {
	# The GUI site. The plaintext listener at the end of this file is the only other site,
	# and it stays off in practice unless you publish :80 and set its allowlist.

	# ---------------------------------------------------------------------
	# TLS — use exactly ONE of the two options
	# ---------------------------------------------------------------------

	# Option A (default, needs no certificate material): Caddy's built-in local
	# CA. The certificate is issued on the first request; clients show a warning
	# until they trust that CA. Export it with:
	#   docker compose exec caddy cat /data/caddy/pki/authorities/local/root.crt > caddy-root.crt
	# then import caddy-root.crt into the OS / browser trust store.
	tls internal

	# Option B (no browser warning): a certificate from your own internal CA.
	# Comment out `tls internal` above, uncomment the line below, and drop the
	# two files into ./certs (mounted read-only at /certs):
	# tls /certs/dsh.example.com.crt /certs/dsh.example.com.key
	# Option C — THE ONE FOR A PUBLIC ADDRESS: let Caddy obtain a certificate from
	# Let's Encrypt / ZeroSSL over ACME. Point DSH_SITE_ADDRESS at a real hostname
	# that resolves to this machine, comment out `tls internal` above, and either
	# remove this `tls` line or give it your contact address. Caddy validates via
	# TLS-ALPN-01 on :443, so :80 does not need to be published for it to work.
	# requirements: the name resolves publicly, and this host's :443 is reachable.
	# tls admin@example.com

	# ---------------------------------------------------------------------
	# Headers
	# ---------------------------------------------------------------------
	header {
		# Only meaningful once clients actually trust the certificate (Option A
		# after the CA import, or Option B). Browsers do NOT record HSTS from a
		# connection with a certificate error, so the "proceed anyway" click keeps
		# working with the untrusted internal CA — but once the CA HAS been trusted
		# and later breaks, HSTS removes that button. See the README troubleshooting
		# table for the escape hatch.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Caveat before relying on this: HSTS is recorded by every browser that
		# loads the site successfully, so a plan to ALSO serve plaintext for the
		# same host is defeated by it — after that first visit the browser upgrades
		# http:// to https:// for a year. Browsers ignore HSTS for IP-literal hosts
		# (an IP-addressed deployment is therefore exempt); a domain is not.
		-Server
	}

	# ---------------------------------------------------------------------
	# Optional second factor in front of DSH's own launch-token login.
	# Generate the hash with:
	#   docker compose exec caddy caddy hash-password --plaintext 'your-password'
	# ---------------------------------------------------------------------
	# basic_auth {
	# 	you $2a$14$REPLACE_WITH_HASH
	# }

	# ---------------------------------------------------------------------
	# Unauthenticated first visit: our page, not dsh's one-liner
	# ---------------------------------------------------------------------
	# A browser arriving with NEITHER a session cookie NOR a token is exactly the
	# bootstrap case, and dsh answers it with one line of plain text. Give it the
	# page that says where the token is. Nothing else moves: a token URL, an
	# existing session, assets and the API all go straight to dsh, and dsh stays
	# the only thing that decides who is authenticated — this route recognises the
	# ABSENCE of a credential and never grants one.
	#
	# The page is a static file served by Caddy, so no dsh plugin and no file in
	# the install tree is involved, and a dsh upgrade cannot break it.
	@firstVisit {
		method GET
		path /
		not header Cookie *dsh-auth-*
		not query token=*
	}
	handle @firstVisit {
		root * /srv/unauth
		rewrite * /index.html
		file_server
	}

	handle {
		# ---------------------------------------------------------------------
		# Upstream
		# ---------------------------------------------------------------------
		# The Host header MUST reach DSH unchanged: the /api browser-trust fence
		# compares it against DSH_TRUSTED_HOSTS, and the session cookie is bound to
		# the host name plus port. reverse_proxy preserves the incoming Host by
		# default — do not add a header_up Host override here.
		reverse_proxy {$DSH_UPSTREAM} {
			# Stream Server-Sent Events and WebSocket frames without buffering.
			# Without this the GUI connects but never finishes loading.
			flush_interval -1
		}
	}
}
# ---------------------------------------------------------------------------
# DEFINED BY DEFAULT, off in practice: a plaintext listener on :80 (no TLS).
#
# READ THE ADDRESS YOU ARE SERVING. On a public address this puts an agent that
# runs commands inside this container behind a channel anyone on the path can read:
# the session cookie is deliberately not marked Secure, so it travels in the clear
# on every request.
#
# What can and cannot be done about that, stated honestly:
#   * an allowlist narrows WHO may connect, so an observer has to sit on the route
#     to your own address — but it does not stop sniffing on that route;
#   * basic_auth is NO help on a cleartext channel: the observer reads those
#     credentials in the same breath as the cookie. It only helps against a cookie
#     that leaked somewhere else, such as a log or a Referer;
#   * so the protection available here is a tight allowlist and sessions that are
#     short-lived, and nothing more.
#
# Preferred on a public address: Option C above (a real domain, so there is neither
# a warning nor cleartext) or an SSH tunnel to a loopback port (README 「出路 B」),
# where the cookie never leaves the client machine.
#
# HSTS TRAP if you later move to a DOMAIN and still want plaintext: the header above
# makes browsers upgrade http:// to https:// for a year after their first successful
# HTTPS visit, so that plaintext entry disappears. Browsers ignore HSTS for IP-literal
# hosts, so an IP-addressed deployment is exempt — this only bites the domain case.
#
# It is DEFINED below and off in practice: while :80 stays unpublished, Caddy
# merely binds :80 inside the container and nothing outside reaches it. Two CONFIG
# changes make it live: set DSH_HTTP_ALLOWED_RANGES (default loopback only, so all
# others get 403), and uncomment the :80 mapping in compose.yaml. The first-visit
# page is served here too, but ONLY to an address inside the allowlist.
http://{$DSH_SITE_ADDRESS} {
	@plainFirstVisit {
		remote_ip {$DSH_HTTP_ALLOWED_RANGES:127.0.0.1/32 ::1/128}
		method GET
		path /
		not header Cookie *dsh-auth-*
		not query token=*
	}
	handle @plainFirstVisit {
		root * /srv/unauth
		rewrite * /index.html
		file_server
	}

	@allowed remote_ip {$DSH_HTTP_ALLOWED_RANGES:127.0.0.1/32 ::1/128}
	handle @allowed {
		reverse_proxy {$DSH_UPSTREAM} {
			flush_interval -1
		}
	}
	respond "plaintext listener: your address is not in DSH_HTTP_ALLOWED_RANGES. See compose.yaml." 403
}

# Copy to .env and fill in. `docker compose` reads .env automatically.
# The values below are already set for the internal deployment target
# https://dsh.example.com — the DeepSeek key is left BLANK on purpose.

# ── required ────────────────────────────────────────────────────────────────

# DeepSeek API key. Passed as a real environment variable on purpose: the
# inherited environment outranks $DSH_HOME/.credentials.yaml and any .env file
# inside a workspace, so a cloned repository cannot redirect this key.
#
# Credential for the PUBLIC api.deepseek.com. Also the credential web_search
# resolves, so keep it if you want the search tool even when every chat model
# comes from the internal endpoint.
#
# ⚠️ NEVER put a real key in THIS file: .env.example is tracked by git and its
#    contents are in the repository history. Real keys belong in .env, which is
#    gitignored. (This file previously carried working-looking keys; if they were
#    ever live, rotate them — deleting a line does not remove it from history.)
DEEPSEEK_API_KEY=

# Credential for the internal vLLM-behind-LiteLLM route declared in
# settings.yaml (the llm-pi-ai provider profile names it via apiKeyEnv).
# LiteLLM normally requires a key even for local models; leave it empty only if
# your LiteLLM is configured without auth (then also delete the apiKeyEnv line
# from that profile).
LITELLM_API_KEY=

# The AUTHORITY a browser will use for the dsh Web GUI — host or IP, NO scheme (the
# Caddyfile supplies https:// and http://) and normally no port, since this name is
# served on the default 443 and browsers omit a default port from the Host header.
#
# ⚠️ This must be EXACTLY the authority people type, an IP address included. It is
# not just a label: Caddy matches the site by it AND obtains its certificate for
# it, so browsing an address that is not listed here fails the TLS handshake with
# ERR_SSL_PROTOCOL_ERROR before any page is served. (That is the sanitised
# placeholder below: replace it with your own host or IP.)
DSH_SITE_ADDRESS=dsh.example.com

# The authority the browser sends in the Host header.
#
# MUST be the same authority as DSH_SITE_ADDRESS, and MUST be the port-less form.
# A port-less entry is resolved to its hostname and compared by hostname alone; an
# entry with an explicit port is compared as host:port. A browser's Host header for a default-port HTTPS URL carries no
# port, so `dsh.example.com:443` would NEVER match — do not "helpfully"
# add :443. The bare name matches on any port, so it stays correct if you later
# move the site to a non-default port.
DSH_TRUSTED_HOSTS=dsh.example.com

# Who may reach the PLAINTEXT :80 listener — only relevant once you uncomment that
# site in Caddyfile AND publish :80 in compose.yaml. Caddy answers anything outside
# this list with 403, and the default is loopback only, so a published :80 replies
# to nobody until you name your clients here. Two shapes:
#   * your own egress address — open https://ifconfig.me FROM THE CLIENT:
#       DSH_HTTP_ALLOWED_RANGES=203.0.113.7/32
#   * everyone, while you are still testing. Cleartext access is then open to the
#     whole internet, and a session cookie on the path can be taken:
#       DSH_HTTP_ALLOWED_RANGES=0.0.0.0/0 ::/0
# Verify from a CLIENT, never from this host: a request originating on the server
# arrives from the docker bridge and is legitimately 403.
DSH_HTTP_ALLOWED_RANGES=127.0.0.1/32 ::1/128

# ── optional ────────────────────────────────────────────────────────────────

# Bundled plugins: every directory under plugins/ is copied to /opt/dsh-plugins at
# build time and enabled at container start (linked into the profile and seeded
# once into $DSH_HOME/cordis.patch.yml, where their options then live — and stay).
# Point this at a mounted host directory to add plugins without rebuilding.
#DSH_PLUGIN_ROOT=/opt/dsh-plugins


# Version of @deepseek-ai/dsh to install into the image.
#
# 0.2.1-rc.2 is the version this deployment is adapted to and was verified
# against. Every `@deepseek-ai/dsh-*` dependency inside a release is pinned to an
# EXACT version (`"@deepseek-ai/dsh-base": "0.2.1-rc.2"`), so one value here
# determines the whole tree: there is no prerelease float to lose against.
#
# The build asserts that the packages the web profile needs are present and all
# equal this value, and names any that are not. A mismatch means a mixed install
# (a second copy at the npm global root, a stale layer, or a .env that disagrees
# with the image tag), and the fix is a clean rebuild:
#   docker compose build --no-cache dsh && docker compose up -d
#
# Splitting a deployment across versions is what used to break this stack in the
# 0.1.5-rc.x era: ranges like `^0.1.5-rc.1` resolved to the newest prerelease, so
# the CLI at rc.1 and dsh-base at rc.3 disagreed and the GUI died with
#   plugin(s) failed to load: @deepseek-ai/dsh-sandbox-local; could not be resolved
# Those ranges are gone, but "one version everywhere" is still the rule.
#
# Upgrading: change this value, rebuild, and read README 「升级到 0.2.1-rc.2」
# (profile layout, settings patch and the home directory all changed shape).
DSH_VERSION=0.2.1-rc.2

# ── optional image layers ───────────────────────────────────────────────────
#
# Both default to 1. Set one to 0 when you would rather have a smaller image and
# do not need the capability. Changing either one REQUIRES a rebuild:
#   docker compose build && docker compose up -d
#
# INSTALL_OFFICE=1 adds LibreOffice (writer/calc/impress, component packages with
# --no-install-recommends so no desktop comes with them) and pandoc — roughly
# half a gigabyte. That is what makes `soffice --headless --convert-to pdf` and
# docx/pptx/xlsx handling work at all.
# INSTALL_PYTHON_DOCS=1 adds the python libraries the agent would otherwise have
# to pip install at run time (which needs egress): document generation
# (python-pptx, python-docx, openpyxl, Pillow) plus the everyday numeric stack
# (numpy, pandas, scipy, matplotlib) and fetch/parse helpers (requests,
# beautifulsoup4, lxml, PyYAML) — roughly 200-250 MB. The name predates the
# numeric stack; read it as "python libraries".
INSTALL_OFFICE=1
INSTALL_PYTHON_DOCS=1

# Port Caddy listens on, published to the host. 443 makes the URL above exactly
# what users type. If something else on this host already owns 443, check first:
#   sudo ss -ltnp 'sport = :443'
# then change this to e.g. 8443 and put that port into DSH_SITE_ADDRESS
# (DSH_TRUSTED_HOSTS still stays port-less, which is correct for any port).
DSH_PUBLIC_PORT=443

# Restrict the published port to one interface, e.g. 127.0.0.1 when a separate
# VPN or jump host is the intended path in.
DSH_PUBLIC_BIND=0.0.0.0

# Directory on the host that becomes the agent's workspace root (/workspaces).
DSH_WORKSPACES=./workspaces

# Identity the container runs as. It must be able to write BOTH DSH_WORKSPACES
# and the host directory mounted at $DSH_HOME (./data/dsh), which holds the
# settings document, profiles, sessions, the browser cookie secret and the
# provider credentials.
#
#   stat -c '%u:%g %n' workspaces data/dsh
#   sudo chown -R <uid>:<gid> data/dsh
#
# The build passes this as --build-arg too, so the image's own user matches and
# files it creates are owned correctly. DSH_UID=0 runs the container as root,
# which works but drops the unprivileged-runtime protection.
DSH_UID=1000
DSH_GID=1000

# read-only | workspace-write | danger-full-access
# danger-full-access also turns the approval prompt off entirely.
DSH_PERMISSION_MODE=workspace-write

# Internal container port. Change it here and Caddy follows via DSH_UPSTREAM.
DSH_BIND_PORT=3080

# Address the dsh webserver binds inside the container.
#
#   auto          (default) the container's own IPv4, detected at every start
#   <IP literal>  bind exactly this address (network_mode: host, special networks)
#   127.0.0.1     loopback only — meaningful only with network_mode: host
#
# dsh 0.2.1 REJECTS 0.0.0.0 (and ::) in the webserver row's config schema, and it
# rejects a hostname too: the row wants "one concrete IPv4 or IPv6 address of a
# local interface". A container behind Caddy must still be reachable from the
# caddy container, so the entrypoint detects the container's address and writes it
# to /data/dsh/.runtime/bind-host (used by the compose healthcheck). Setting a
# wildcard here logs a warning and falls back to detection — it does not silently
# keep the old behaviour, because the old behaviour no longer boots.
#
# Do NOT set 127.0.0.1 to "make the published port private": Docker publishes by
# DNAT-ing to the container IP, so a loopback-only listener cannot be reached
# through a published port. Leave this at auto.
#DSH_BIND_HOST=auto

# Proxy bypass list for the dsh container (NO_PROXY / no_proxy).
#
# Docker injects HTTP(S)_PROXY from ~/.docker/config.json into containers. This
# service needs outbound access to the model endpoints, so unlike caddy it cannot
# clear the proxy; it only bypasses the ranges that are never behind a proxy:
# loopback, the container itself, and the compose network (172.16.0.0/12 covers
# Docker's default 172.18+ subnets). The healthcheck and every in-container
# curl/wget/git rely on this.
#
# Add your own internal endpoints when they are outside those ranges, e.g. a
# LiteLLM on 10.x:
#   DSH_NO_PROXY=127.0.0.1,localhost,172.16.0.0/12,10.0.0.0/8
#DSH_NO_PROXY=127.0.0.1,localhost,172.16.0.0/12

# Any non-empty value opts out of OpenTelemetry upload. The separate DeepSeek
# session-log contribution is opt-in and off by default; it is controlled by its
# own `enabled` row config, not by this variable.
DSH_TELEMETRY_DISABLED=1

TZ=UTC